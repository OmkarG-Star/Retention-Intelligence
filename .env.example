# Copy to .env and adjust. Every value has a working default.
APP_NAME="Retention Intelligence"
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Change this before any deployment that is not on your own laptop.
SECRET_KEY=replace-with-a-long-random-string
SESSION_TTL_HOURS=12

# Simulation controls (ignored once you point the loader at real data)
SIM_EMPLOYEES=3200
SIM_SEED=20260918
SIM_START=2023-04-01
SIM_END=2026-09-18

# Chronological split, in months back from the data cutoff
VALIDATION_MONTHS=4
TEST_MONTHS=4

# Optional. Without it the copilot still answers from retrieved facts using
# deterministic templates; with it, the same facts are phrased by the model.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
